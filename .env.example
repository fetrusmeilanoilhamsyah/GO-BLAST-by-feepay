# Lingkungan & Alamat Aplikasi
APP_ENV=dev
APP_ADDR=127.0.0.1:8080
ALLOW_PUBLIC_BIND=false
APP_PUBLIC_HOST=localhost:8080

# Basis Data PostgreSQL
DATABASE_URL=postgres://goblast:dummy_password@localhost:5432/goblast_dev?sslmode=disable
TEST_DATABASE_URL=postgres://goblast:dummy_password@localhost:5432/goblast_test?sslmode=disable
DB_MAX_CONNS=25
DB_MIN_CONNS=5

# Rahasia Sesi & Kriptografi
SESSION_SECRET=dummy_session_secret_change_me
# ENCRYPTION_KEY wajib di semua lingkungan (base64 dari 32 byte acak).
# Cara membuat kunci acak di PowerShell:
# $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREV=

# Cadangan Database (.gbak terenkripsi AES-256-GCM)
# BACKUP_KEY wajib untuk fitur cadangan (base64 dari 32 byte acak, berbeda dari ENCRYPTION_KEY).
BACKUP_KEY=
BACKUP_KEY_PREV=
ALLOW_WEB_RESTORE=false

# Batas Sesi WhatsApp Aktif Simultan
# MAX_ACTIVE_SESSIONS wajib di prod, bawaan 50 di dev dan test (diukur empiris di H10: 75-80 sesi aman).
MAX_ACTIVE_SESSIONS=50

# Kontak CS & Channel Resmi
CS_WHATSAPP_URL=https://wa.me/6281200000000
CS_TELEGRAM_URL=https://t.me/feepay_cs
CHANNEL_TELEGRAM_URL=https://t.me/goblast_channel

# Reverse Proxy & Keamanan Jaringan
CLIENT_IP_HEADER=CF-Connecting-IP
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Cloudflare Turnstile Anti-Bot (Opsional di dev, uji di staging/prod)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=